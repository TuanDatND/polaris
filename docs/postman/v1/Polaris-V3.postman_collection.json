        "url": "{{base_url}}/api/v1/instances",
        "description": "202 confirms intent acceptance. currentState need not be RUNNING yet. The following poll checks convergence.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"postman-v3-{{run_id}}\",\n  \"imageName\": \"{{image_name}}\",\n  \"cpu\": 1,\n  \"ramMb\": 128\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function check(name, condition) {",
              "    pm.test(name, function () { pm.expect(condition, name).to.eql(true); });",
              "    if (!condition) {",
              "        pm.execution.setNextRequest(null);",
              "        throw new Error(name);",
              "    }",
              "}",
              "function jsonResponse(status) {",
              "    check(\"HTTP \" + status + \" (actual \" + pm.response.code + \")\", pm.response.code === status);",
