{
  "info": {
    "_postman_id": "fde7aa22-ac09-4da4-bd9c-7795740d7a42",
    "name": "Polaris V3 - Lifecycle API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local API integration smoke tests grounded in the current Spring Security form-login + CSRF configuration. Requires existing app user, running PostgreSQL/Docker, and nginx:alpine pulled into the Docker daemon used by Polaris. Import the environment, set username/password, then run the entire collection with delay 1000 ms, iterations 1. Creates one tenant and one instance; the instance is deleted on success. Tenant remains. Stops on first assertion failure; instance_id remains available for manual DELETE cleanup. Does not verify provider drift, claim races, internal COMPLETED status or quota release (not exposed by current GET response)."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "tenant_id",
      "value": ""
    },
    {
      "key": "instance_id",
      "value": ""
    },
    {
      "key": "csrf_token",
      "value": ""
    }
  ],
  "item": [
    {
      "id": "d3074e63-790b-4ad7-a142-000000000001",
      "name": "01 - Get login CSRF",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          }
        ],
        "url": "{{base_url}}/login",
        "description": "Initializes a new test run and obtains Spring Security's CSRF token. Requires an existing username/password in the selected environment."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"username\") || !pm.environment.get(\"password\")) {",
              "    pm.execution.setNextRequest(null);",
              "    throw new Error(\"Set username and password in the selected Polaris Local environment. Use an existing app user.\");",
              "}",
              "const runId = Date.now().toString() + \"-\" + pm.variables.replaceIn(\"{{$guid}}\").slice(0, 8);",
              "pm.collectionVariables.set(\"run_id\", runId);",
              "pm.collectionVariables.set(\"tenant_id\", \"\");",
              "pm.collectionVariables.set(\"instance_id\", \"\");",
              "pm.collectionVariables.set(\"csrf_token\", \"\");",
              "[\"poll_create\", \"poll_stop\", \"poll_restart\", \"poll_delete\"].forEach(function (key) {",
              "    pm.variables.unset(key);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function check(name, condition) {",
              "    pm.test(name, function () { pm.expect(condition, name).to.eql(true); });",
              "    if (!condition) {",
              "        pm.execution.setNextRequest(null);",
              "        throw new Error(name);",
              "    }",
              "}",
              "function jsonResponse(status) {",
              "    check(\"HTTP \" + status + \" (actual \" + pm.response.code + \")\", pm.response.code === status);",
              "    check(\"Response is JSON\", /application\\/json/i.test(pm.response.headers.get(\"Content-Type\") || \"\"));",
              "    return pm.response.json();",
              "}",
              "function checkInstance(body, desired) {",
              "    check(\"Correct instance\", body.id === pm.collectionVariables.get(\"instance_id\"));",
              "    check(\"Correct tenant\", body.tenantId === pm.collectionVariables.get(\"tenant_id\"));",
              "    check(\"Desired state is \" + desired, body.desiredState === desired);",
              "}",
              "check(\"Login page HTTP 200\", pm.response.code === 200);",
              "const html = pm.response.text();",
              "const input = (html.match(/<input\\b[^>]*>/gi) || []).find(function (tag) {",
              "    return /\\bname\\s*=\\s*[\"']_csrf[\"']/i.test(tag);",
              "});",
              "const match = input && input.match(/\\bvalue\\s*=\\s*[\"']([^\"']+)[\"']/i);",
              "check(\"CSRF token exists in login form\", !!match);",
              "pm.collectionVariables.set(\"csrf_token\", match[1]);"
            ]
          }
        }
      ]
    },
    {
      "id": "d3074e63-790b-4ad7-a142-000000000002",
      "name": "02 - Login with session",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{base_url}}/login",
        "description": "Form login; redirects are disabled so a redirect to /login?error cannot appear as a successful 200. Postman manages session cookies automatically.",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "text"
            },
            {
              "key": "_csrf",
              "value": "{{csrf_token}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function check(name, condition) {",
              "    pm.test(name, function () { pm.expect(condition, name).to.eql(true); });",
              "    if (!condition) {",
              "        pm.execution.setNextRequest(null);",
              "        throw new Error(name);",
              "    }",
              "}",
              "function jsonResponse(status) {",
              "    check(\"HTTP \" + status + \" (actual \" + pm.response.code + \")\", pm.response.code === status);",
              "    check(\"Response is JSON\", /application\\/json/i.test(pm.response.headers.get(\"Content-Type\") || \"\"));",
              "    return pm.response.json();",
              "}",
              "function checkInstance(body, desired) {",
              "    check(\"Correct instance\", body.id === pm.collectionVariables.get(\"instance_id\"));",
              "    check(\"Correct tenant\", body.tenantId === pm.collectionVariables.get(\"tenant_id\"));",
              "    check(\"Desired state is \" + desired, body.desiredState === desired);",
              "}",
              "check(\"Login returns a redirect\", [302, 303].includes(pm.response.code));",
              "const location = pm.response.headers.get(\"Location\") || \"\";",
              "check(\"Login succeeded (no error redirect)\", location.length > 0 && !/[?&]error(?:[=&]|$)/i.test(location) && !/\\/login(?:[?#]|$)/i.test(location));"
            ]
          }
        }
      ]
    },
    {
