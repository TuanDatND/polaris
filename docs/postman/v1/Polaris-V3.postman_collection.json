    {
      "id": "d3074e63-790b-4ad7-a142-000000000004",
      "name": "04 - Create isolated test tenant",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrf_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/tenants",
        "description": "Creates a fresh tenant for this run. Tenant is retained because the project exposes no tenant DELETE API. Quota allows exactly one test instance.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"postman-v3-{{run_id}}\",\n  \"quotaCpu\": 2,\n  \"quotaRamMb\": 1024,\n  \"quotaInstanceCount\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function check(name, condition) {",
              "    pm.test(name, function () { pm.expect(condition, name).to.eql(true); });",
              "    if (!condition) {",
              "        pm.execution.setNextRequest(null);",
              "        throw new Error(name);",
              "    }",
              "}",
              "function jsonResponse(status) {",
              "    check(\"HTTP \" + status + \" (actual \" + pm.response.code + \")\", pm.response.code === status);",
              "    check(\"Response is JSON\", /application\\/json/i.test(pm.response.headers.get(\"Content-Type\") || \"\"));",
              "    return pm.response.json();",
              "}",
              "function checkInstance(body, desired) {",
              "    check(\"Correct instance\", body.id === pm.collectionVariables.get(\"instance_id\"));",
              "    check(\"Correct tenant\", body.tenantId === pm.collectionVariables.get(\"tenant_id\"));",
              "    check(\"Desired state is \" + desired, body.desiredState === desired);",
              "}",
              "const body = jsonResponse(201);",
              "check(\"Tenant id exists\", typeof body.id === \"string\" && body.id.length > 0);",
              "check(\"New tenant has no allocated instances\", body.allocatedInstanceCount === 0);",
              "pm.collectionVariables.set(\"tenant_id\", body.id);"
            ]
          }
        }
      ]
    },
