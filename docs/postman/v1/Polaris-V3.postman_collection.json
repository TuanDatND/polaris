              "}",
              "function checkInstance(body, desired) {",
              "    check(\"Correct instance\", body.id === pm.collectionVariables.get(\"instance_id\"));",
              "    check(\"Correct tenant\", body.tenantId === pm.collectionVariables.get(\"tenant_id\"));",
              "    check(\"Desired state is \" + desired, body.desiredState === desired);",
              "}",
              "const body = jsonResponse(202);",
              "check(\"Instance id exists\", typeof body.id === \"string\" && body.id.length > 0);",
              "pm.collectionVariables.set(\"instance_id\", body.id);",
              "checkInstance(body, \"RUNNING\");",
              "check(\"CPU allocation preserved\", body.cpuAllocated === 1);",
              "check(\"RAM allocation preserved\", body.ramMb === 128);"
            ]
          }
        }
      ]
    },
    {
      "id": "d3074e63-790b-4ad7-a142-000000000007",
      "name": "07 - Wait for initial RUNNING",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Tenant-Id",
            "value": "{{tenant_id}}"
          }
        ],
        "url": "{{base_url}}/api/v1/instances/{{instance_id}}",
        "description": "Poll until currentState and desiredState are RUNNING; stops on FAILED or after max_poll_attempts. Run the entire collection with a 1000 ms Runner delay. Send alone does not repeat automatically."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function check(name, condition) {",
              "    pm.test(name, function () { pm.expect(condition, name).to.eql(true); });",
              "    if (!condition) {",
              "        pm.execution.setNextRequest(null);",
              "        throw new Error(name);",
              "    }",
              "}",
              "function jsonResponse(status) {",
              "    check(\"HTTP \" + status + \" (actual \" + pm.response.code + \")\", pm.response.code === status);",
              "    check(\"Response is JSON\", /application\\/json/i.test(pm.response.headers.get(\"Content-Type\") || \"\"));",
              "    return pm.response.json();",
              "}",
              "function checkInstance(body, desired) {",
              "    check(\"Correct instance\", body.id === pm.collectionVariables.get(\"instance_id\"));",
              "    check(\"Correct tenant\", body.tenantId === pm.collectionVariables.get(\"tenant_id\"));",
              "    check(\"Desired state is \" + desired, body.desiredState === desired);",
              "}",
              "const body = jsonResponse(200);",
              "checkInstance(body, \"RUNNING\");",
              "check(\"Instance has not FAILED: \" + (body.failureReason || \"\"), body.currentState !== \"FAILED\");",
              "const key = \"poll_create\";",
              "const attempt = Number(pm.variables.get(key) || 0) + 1;",
              "const limit = Number(pm.environment.get(\"max_poll_attempts\") || 120);",
              "check(\"max_poll_attempts is a positive integer\", Number.isInteger(limit) && limit > 0);",
              "if (body.currentState === \"RUNNING\") {",
              "    check(\"Converged to RUNNING\", true);",
              "    check(\"Provider resource attached\", typeof body.containerId === \"string\" && body.containerId.length > 0);",
              "    pm.variables.unset(key);",
              "} else {",
              "    check(\"Convergence timeout: expected RUNNING, actual \" + body.currentState + \", attempt \" + attempt + \"/\" + limit, attempt < limit);",
              "    pm.variables.set(key, attempt);",
              "    console.log(\"07 - Wait for initial RUNNING: still \" + body.currentState + \" (\" + attempt + \"/\" + limit + \")\");",
              "    pm.execution.setNextRequest(pm.info.requestId);",
              "}"
            ]
          }
        }
      ]
    },
