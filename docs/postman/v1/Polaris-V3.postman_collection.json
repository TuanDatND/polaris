    {
      "id": "d3074e63-790b-4ad7-a142-000000000006",
      "name": "06 - Create instance",
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Tenant-Id",
            "value": "{{tenant_id}}"
